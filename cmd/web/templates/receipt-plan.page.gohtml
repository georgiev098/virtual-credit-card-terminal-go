{{template "base".}}

{{define "title"}}
    Payment Succeeded!
    {{end}}

    {{define "content"}}
    {{$txn := index .Data "txn"}}
        <h2 class="mt-5">Payment Succeeded! </h2>
        <h2>
        <p>First Name: {{$txn.FirstName}} <span id="first_name"></span> </p>
        <p>Last Name: {{$txn.LastName}} <span id="last_name"></span></p>
        <p>Payment Amount: {{formatCurr $txn.Amount}} <span id="amount"></span> </p>
        <p>Last Four: {{$txn.LastFour}} <span id="last_four"></span></p>
    {{end}}


    {{define "js"}}
    <script>
    if(sessionStorage.first_name){
    document.getElementById("first_name").innerHTML = sessionStorage.first_name;
    document.getElementById("last_name").innerHTML = sessionStorage.last_name;
    document.getElementById("amount").innerHTML = sessionStorage.amount;
    document.getElementById("last_four").innerHTML = sessionStorage.last_four;

    sessionStorage.clear();
    }
    
    </script>
    {{end}}