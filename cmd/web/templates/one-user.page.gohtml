{{template "base" .}}
{{define "title"}}
Admin User
{{end}}

{{define "content"}}
<h2 class="mt-5">Admin user</h2>
<hr>

<form method="post" action="" name="user-form" id="user-form" class="needs-validation" autocomplete="off" novalidate="">
    <div class="mb-3">
        <label for="first_name" class="form-label">First Name</label>
        <input  type="text" class="form-control" id="first_name" name="first_name" required="" autocomplete="first_name-new"></input>
    </div>

    <div class="mb-3">
        <label for="last_name" class="form-label">Last Name</label>
        <input  type="text" class="form-control" id="last_name" name="last_name" required="" autocomplete="last_name-new"></input>
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input  type="email" class="form-control" id="email" name="email" required="" autocomplete="email-new"></input>
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input  type="password" class="form-control" id="password" name="password" required="" autocomplete="password-new"></input>
    </div>

    <div class="mb-3">
        <label for="verify-password" class="form-label">Verify Password</label>
        <input  type="password" class="form-control" id="verify-password" name="verify-password" autocomplete="verify-password-new"></input>
    </div>

    <hr>
    <div class="float-start">
        <a class="btn btn-primary" href="javascript:void(0);" id="save-btn">Save Changes</a>
        <a class="btn btn-warning" href="/admin/all-users" id="cancel-btn">Cancel</a>
    </div>
    <div class="float-end">
        <a class="btn btn-danger" href="javascript:void(0);" id="delete-btn">Delete</a>
    </div>


</form>


{{end}}

{{define "js"}}
<script>
    document.addEventListener("DOMContentLoaded",()=>{
        let token = localStorage.getItem("token");
        let id = window.location.pathname.split("/").pop()

        
     const reqOptions = {

        method:"GET",
        headers: {
            "Accept":"application/json",
            "Content-Type":"application/json",
            "Authorization":"Bearer " + token,
        }
    }
            fetch(`http://localhost:4001/api/admin/all-users/${id}`, reqOptions).then(resp=>resp.json()).then(data=>{
                console.log(data)
            })
    })

</script>
{{end}}