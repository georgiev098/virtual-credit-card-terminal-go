{{template "base" .}}


{{define "title"}}
All Sales
{{end}}

{{define "content"}}
<h2 class="mt-5"> All Sales</h2>
<hr>

<table id="sales-table" class="table table-striped">
<thead>
    <tr>
        <th>Transaction</th>
        <th>Customer</th>
        <th>Product</th>
        <th>Amount</th>
    </tr>
    <tbody>
    
    </tbody>
</thead>

</table>
{{end}}


{{define "js"}}

<script>
let token = localStorage.getItem("token")
let tbody = document
  .getElementById("sales-table")
  .getElementsByTagName("tbody")[0]
const reqOptions = {

    method:"POST",
    headers: {
        "Accept":"application/json",
        "Content-Type":"application/json",
        "Authorization":"Bearer " + token
    },
}

fetch("http://localhost:4001/api/admin/all-sales", reqOptions).then(resp=>resp.json()).then(data=>{
    console.log(data)
})
</script>
{{end}}