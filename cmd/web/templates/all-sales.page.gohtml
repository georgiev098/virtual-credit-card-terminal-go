{{template "base" .}}


{{define "title"}}
All Sales
{{end}}

{{define "content"}}
<h2 class="mt-5"> All Sales</h2>
<hr>

<table id="sales-table" class="table table-striped">
<thead>
    <tr>
        <th>Transaction</th>
        <th>Customer</th>
        <th>Product</th>
        <th>Amount</th>
        <th>Status</th>
    </tr>
    <tbody>
    
    </tbody>
</thead>

</table>
{{end}}


{{define "js"}}

<script>
let token = localStorage.getItem("token")
let tbody = document
  .getElementById("sales-table")
  .getElementsByTagName("tbody")[0]
const reqOptions = {

    method:"POST",
    headers: {
        "Accept":"application/json",
        "Content-Type":"application/json",
        "Authorization":"Bearer " + token
    },
}

fetch("http://localhost:4001/api/admin/sales", reqOptions).then(resp=>resp.json()).then(data=>{
    console.log(data)

    if(data){
        data.forEach(sale=>{
            let newRow = tbody.insertRow();
            let newCell = newRow.insertCell();

            newCell.innerHTML = `<a href="/admin/sales/${sale.id}">Order ${sale.id}</a>`

            newCell = newRow.insertCell()
            let item = document.createTextNode(sale.customer.last_name + ", " + sale.customer.first_name) 
            newCell.appendChild(item)

            newCell = newRow.insertCell()
            item = document.createTextNode(sale.widget.name)
            newCell.appendChild(item)


            let curr = formatCurr(sale.transaction.amount)
            newCell = newRow.insertCell()
            item = document.createTextNode(curr)
            newCell.appendChild(item)

            newCell = newRow.insertCell()
            if(sale.status_id != 1){
            newCell.innerHTML = `<span class="badge bg-danger">Refunded</span>`
            }else{
            newCell.innerHTML = `<span class="badge bg-success">Charged</span>`
            }
        })
    } else {
        let newRow = tbody.insertRow();
        let newCell = newRow.insertCell();

        newCell.setAttribute("colspan", "4")
        newCell.innerHTML = "No data available."

    }
})


function formatCurr(amount){
    let c = parseFloat(amount/100)
    return c.toLocaleString("eur", {
        style: "currency",
        currency: "EUR"
    })
}
</script>
{{end}}