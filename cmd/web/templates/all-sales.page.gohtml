{{template "base" .}}


{{define "title"}}
All Sales
{{end}}

{{define "content"}}
<h2 class="mt-5"> All Sales</h2>
<hr>

<table id="sales-table" class="table table-striped">
<thead>
    <tr>
        <th>Transaction</th>
        <th>Customer</th>
        <th>Product</th>
        <th>Amount</th>
        <th>Status</th>
    </tr>
    <tbody>
    
    </tbody>
</thead>

</table>

    <nav>
        <ul id="paginator" class="pagination">
        
        </ul>
    
    </nav>
{{end}}


{{define "js"}}

<script>

let currPage = 1;
let pageSize = 3;

function paginator(pages,currPage){
    let p = document.getElementById("paginator")

    let html = `<li class="page-item">
        <a href="#!" class="page-link pager" data-page="${currPage - 1}">&lt;</a>
    </li>`

    for(let i=0;i<=pages;i++){
        html += `<li class="page-item">
        <a href="#!" class="page-link pager" data-page="${i + 1}">${i + 1}</a>
    </li>`
    }

    html += `<li class="page-item">
        <a href="#!" class="page-link pager" data-page="${currPage + 1}">&gt;</a>
    </li>`

    p.innerHTML = html
}

function updateTable(ps, cp){
    let token = localStorage.getItem("token")
    let tbody = document
    .getElementById("sales-table")
    .getElementsByTagName("tbody")[0]

    let body = {
        page_size: ps,
        curr_page: cp,
    }
    const reqOptions = {

        method:"POST",
        headers: {
            "Accept":"application/json",
            "Content-Type":"application/json",
            "Authorization":"Bearer " + token
        },
        body: JSON.stringify(body),
    }

    fetch("http://localhost:4001/api/admin/sales", reqOptions).then(resp=>resp.json()).then(data=>{
        console.log(data)

        if(data.orders){
            data.orders.forEach(sale=>{
                let newRow = tbody.insertRow();
                let newCell = newRow.insertCell();

                newCell.innerHTML = `<a href="/admin/sales/${sale.id}">Order ${sale.id}</a>`

                newCell = newRow.insertCell()
                let item = document.createTextNode(sale.customer.last_name + ", " + sale.customer.first_name) 
                newCell.appendChild(item)

                newCell = newRow.insertCell()
                item = document.createTextNode(sale.widget.name)
                newCell.appendChild(item)


                let curr = formatCurr(sale.transaction.amount)
                newCell = newRow.insertCell()
                item = document.createTextNode(curr)
                newCell.appendChild(item)

                newCell = newRow.insertCell()
                if(sale.status_id != 1){
                newCell.innerHTML = `<span class="badge bg-danger">Refunded</span>`
                }else{
                newCell.innerHTML = `<span class="badge bg-success">Charged</span>`
                }
            })
            paginator(data.last_page, data.curr_page)
        } else {
            let newRow = tbody.insertRow();
            let newCell = newRow.insertCell();

            newCell.setAttribute("colspan", "4")
            newCell.innerHTML = "No data available."
        }
    })
}

document.addEventListener("DOMContentLoaded", function(){
 updateTable(pageSize,currPage)   
})



function formatCurr(amount){
    let c = parseFloat(amount/100)
    return c.toLocaleString("eur", {
        style: "currency",
        currency: "EUR"
    })
}
</script>
{{end}}