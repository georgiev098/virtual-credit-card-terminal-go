{{template "base" .}}
{{define "title"}}
All Users
{{end}}

{{define "content"}}
<h2 class="mt-5">All admin users</h2>
<hr>

<div class="float-end">
    <a class="btn btn-outline-secondary" href="/admin/all-users/0">Add user</a>
</div>
<div class="clearfix"></div>

<table id="user-table" class="table table-striped">
    <thead>
        <tr>
            <th>User</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>

    </tbody>
</table>
{{end}}

{{define "js"}}
<script>
document.addEventListener("DOMContentLoaded",()=>{
    let tbody = document.getElementById("user-table").getElementsByTagName("tbody")[0]
    let token = localStorage.getItem("token")

     const reqOptions = {

        method:"GET",
        headers: {
            "Accept":"application/json",
            "Content-Type":"application/json",
            "Authorization":"Bearer " + token,
        }
    }

    fetch("http://localhost:4001/api/admin/all-users", reqOptions).then(resp=>resp.json()).then(data=>{
        console.log(data)
    })
})

</script>
{{end}}