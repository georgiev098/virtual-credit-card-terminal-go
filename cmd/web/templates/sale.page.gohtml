{{template "base" .}}

{{define "title"}}
{{index .StringMap "title"}}
{{end}}

{{define "content"}}
<h2 class="mt-5">{{index .StringMap "title"}}</h2>
<span id="refunded" class="badge bg-danger d-none">{{index .StringMap "refunded-badge"}}</span>
<span id="charged" class="badge bg-success d-none">Charged</span>
<hr>
<div class="alert alert-danger text-center d-none" id="messages"></div>

<div>
    <strong>Order No:</strong> <span id="order-no"></span><br>
    <strong>Customer</strong> <span id="customer"></span><br>
    <strong>Customer Email:</strong> <span id="customer-email"></span><br>
    <strong>Produc</strong> <span id="product"></span><br>
    <strong>Quantity</strong> <span id="quantity"></span><br>
    <strong>Amount</strong> <span id="amount"></span><br>

    <hr>

    <a class="btn btn-info" href='{{index .StringMap "cancel"}}'>Cancel</a>
    <a  id="refund-btn" class="btn btn-warning d-none" href="#">{{index .StringMap "refund-btn"}}</a>

    <input type="hidden" id="charge-id" value="">
    <input type="hidden" id="charge-amount" value="">
    <input type="hidden" id="currency" value="">

</div>

{{end}}

{{define "js"}}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
let token = localStorage.getItem("token")
let orderID = window.location.pathname.split("/").pop()
let messagesDiv = document.getElementById("messages");

function showError(msg){
    messagesDiv.classList.add("alert-danger")
    messagesDiv.classList.remove("alert-success")
    messagesDiv.classList.remove("d-none")
    messagesDiv.innerText = msg
}
function showSuccess(msg){
    messagesDiv.classList.add("alert-success")
    messagesDiv.classList.remove("alert-danger")
    messagesDiv.classList.remove("d-none")
    messagesDiv.innerText = msg
}


const reqOptions = {
    method:"POST",
    headers: {
        "Accept":"application/json",
        "Content-Type":"application/json",
        "Authorization":"Bearer " + token
    },
}

fetch(`http://localhost:4001/api/admin/sales/${orderID}`, reqOptions).then(resp=>resp.json()).then(data=>{
        if(data){
        console.log(data)
            document.getElementById("order-no").innerHTML = data.id;
            document.getElementById("customer").innerHTML = data.customer.first_name + " " + data.customer.last_name;
            document.getElementById("customer-email").innerHTML = data.customer.email;
            document.getElementById("product").innerHTML = data.widget.name;
            document.getElementById("quantity").innerHTML = data.quantity;
            document.getElementById("amount").innerHTML = formatCurr(data.transaction.amount);
            document.getElementById("charge-id").value = data.transaction.bank_return_code;
            document.getElementById("charge-amount").value = data.transaction.amount;
            document.getElementById("currency").value = data.transaction.currency;
           
           // Reset UI state first (VERY IMPORTANT)
            document.getElementById("refund-btn").classList.add("d-none")
            document.getElementById("refunded").classList.add("d-none")
            document.getElementById("charged").classList.add("d-none")
            
            if (data.status_id === 1) {
            // Charged
            document.getElementById("refund-btn").classList.remove("d-none")
            document.getElementById("charged").classList.remove("d-none")
            }

            if (data.status_id === 2) {
                // Refunded
                document.getElementById("refunded").classList.remove("d-none")
            }
        }else{}
})


function formatCurr(amount){
    let c = parseFloat(amount/100)
    return c.toLocaleString("eur", {
        style: "currency",
        currency: "EUR"
    })
}

    document.getElementById("refund-btn").addEventListener("click", ()=>{
            Swal.fire({
                            title: "Are you sure?",
                            text: "You won't be able to undo this!",
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#3085d6",
                            cancelButtonColor: "#d33",
                            confirmButtonText: "Refund"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            let chargeID = document.getElementById("charge-id").value;
                            let amount = parseInt(document.getElementById("charge-amount").value, 10);
                            let currency =  document.getElementById("currency").value;
                            

                            let payload = {
                                charge_id: chargeID,
                                amount,
                                currency,
                                id: parseInt(orderID, 10)
                            }

                            
                            const requestOptions = {
                                method:"POST",
                                headers: {
                                    "Accept":"application/json",
                                    "Content-Type":"application/json",
                                    "Authorization":"Bearer " + token
                                },
                                body: JSON.stringify(payload)
                            }

                            fetch("http://localhost:4001{{index .StringMap "refund-url"}}", requestOptions).then(resp=>resp.json()).then(data=>{
                                if(data.error){
                                    showError(data.message)
                                }else{
                                    showSuccess("{{index .StringMap "refunded-msg"}}")
                                   document.getElementById("refunded").classList.remove("d-none")
                                    document.getElementById("charged").classList.add("d-none")  
                                    document.getElementById("refund-btn").classList.add("d-none")
                                }
                            })

                    }
                });
    })
</script>
{{end}}