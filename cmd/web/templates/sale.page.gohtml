{{template "base" .}}

{{define "title"}}
Sale
{{end}}

{{define "content"}}
<h2 class="mt-5">Sale</h2>
<hr>

<div>
    <strong>Order No:</strong> <span id="order-no"></span><br>
    <strong>Customer</strong> <span id="customer"></span><br>
    <strong>Customer Email:</strong> <span id="customer-email"></span><br>
    <strong>Produc</strong> <span id="product"></span><br>
    <strong>Quantity</strong> <span id="quantity"></span><br>
    <strong>Amount</strong> <span id="amount"></span><br>

    <hr>

    <a class="btn btn-info" href="/admin/sales">Cancel</a>
    <a class="btn btn-warning" href="#">Refund order</a>

</div>

{{end}}

{{define "js"}}
<script>
let token = localStorage.getItem("token")
let orderID = window.location.pathname.split("/").pop()


const reqOptions = {
    method:"POST",
    headers: {
        "Accept":"application/json",
        "Content-Type":"application/json",
        "Authorization":"Bearer " + token
    },
}

fetch(`http://localhost:4001/api/admin/sales/${orderID}`, reqOptions).then(resp=>resp.json()).then(data=>{
        if(data){
        console.log(data)
            document.getElementById("order-no").innerHTML = data.id;
            document.getElementById("customer").innerHTML = data.customer.first_name + " " + data.customer.last_name;
            document.getElementById("customer-email").innerHTML = data.customer.email;
            document.getElementById("product").innerHTML = data.widget.name;
            document.getElementById("quantity").innerHTML = data.quantity;
            document.getElementById("amount").innerHTML = formatCurr(data.transaction.amount);
        }else{}
})


function formatCurr(amount){
    let c = parseFloat(amount/100)
    return c.toLocaleString("eur", {
        style: "currency",
        currency: "EUR"
    })
}
</script>
{{end}}