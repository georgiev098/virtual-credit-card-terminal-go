{{template "base" .}}


{{define "title"}}
All Subscriptions
{{end}}

{{define "content"}}
<h2 class="mt-5"> All Subscriptions</h2>
<hr>

<table id="sales-table" class="table table-striped">
<thead>
    <tr>
        <th>Transaction</th>
        <th>Customer</th>
        <th>Product</th>
        <th>Amount</th>
        <th>Status</th>
    </tr>
    <tbody>
    
    </tbody>
</thead>

</table>
 <nav>
        <ul id="paginator" class="pagination">
        
        </ul>
    
    </nav>
{{end}}


{{define "js"}}

<script>
let currPage = 1;
let pageSize = 5;

function paginator(pages, currPage) {
    let p = document.getElementById("paginator");

    let html = `
        <li class="page-item">
            <a href="#!" class="page-link pager" data-page="${currPage - 1}">&lt;</a>
        </li>
    `;

    for (let i = 0; i < pages; i++) {
        html += `
            <li class="page-item ${currPage === i + 1 ? "active" : ""}">
                <a href="#!" class="page-link pager" data-page="${i + 1}">${i + 1}</a>
            </li>
        `;
    }

    html += `
        <li class="page-item">
            <a href="#!" class="page-link pager" data-page="${currPage + 1}">&gt;</a>
        </li>
    `;

    p.innerHTML = html;

    let pageButtons = document.getElementsByClassName("pager");
    for (let j = 0; j < pageButtons.length; j++) {
        pageButtons[j].addEventListener("click", (e) => {
            let desiredPage = parseInt(e.target.dataset.page, 10);
            if (desiredPage > 0 && desiredPage <= pages) {
                updateTable(pageSize, desiredPage);
            }
        });
    }
}

function updateTable(ps, cp) {
    let token = localStorage.getItem("token");
    let tbody = document
        .getElementById("sales-table")
        .getElementsByTagName("tbody")[0];

    // ✅ clear previous page
    tbody.innerHTML = "";

    let body = {
        page_size: ps,
        curr_page: cp,
    };

    fetch("http://localhost:4001/api/admin/subscriptions", {
        method: "POST",
        headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token,
        },
        body: JSON.stringify(body),
    })
        .then(resp => resp.json())
        .then(data => {
            if (data.subscriptions) {
                data.subscriptions.forEach(subscription => {
                    let newRow = tbody.insertRow();

                    let cell = newRow.insertCell();
                    cell.innerHTML = `<a href="/admin/subscriptions/${subscription.id}">Order ${subscription.id}</a>`;

                    cell = newRow.insertCell();
                    cell.textContent = `${subscription.customer.last_name}, ${subscription.customer.first_name}`;

                    cell = newRow.insertCell();
                    cell.textContent = subscription.widget.name;

                    cell = newRow.insertCell();
                    cell.textContent = formatCurr(subscription.transaction.amount) + "/month";

                    cell = newRow.insertCell();
                    cell.innerHTML =
                        subscription.status_id !== 1
                            ? `<span class="badge bg-danger">Cancelled</span>`
                            : `<span class="badge bg-success">Active</span>`;
                });

                paginator(data.last_page, data.curr_page);
            } else {
                let newRow = tbody.insertRow();
                let cell = newRow.insertCell();
                cell.setAttribute("colspan", "5");
                cell.textContent = "No data available.";
            }
        });
}

document.addEventListener("DOMContentLoaded", function () {
    updateTable(pageSize, currPage);
});

function formatCurr(amount) {
    let c = amount / 100;
    return c.toLocaleString("eur", {
        style: "currency",
        currency: "EUR",
    });
}
</script>

{{end}}